# Khata backend configuration. Copy to .env and replace every CHANGE_ME value.
# .env is git-ignored. Production refuses to start with any placeholder below.

KHATA_ENV=dev                      # dev | test | staging | production
KHATA_LOG_LEVEL=INFO

# Local PostgreSQL roles created by `make db-bootstrap` (scripts/db_bootstrap.sql).
KHATA_DB_OWNER_PASSWORD=CHANGE_ME_owner_password
KHATA_DB_APP_PASSWORD=CHANGE_ME_app_password
KHATA_DATABASE_URL_APP=postgresql+psycopg://khata_app:CHANGE_ME_app_password@/khata_dev?host=/tmp
KHATA_DATABASE_URL_OWNER=postgresql+psycopg://khata_owner:CHANGE_ME_owner_password@/khata_dev?host=/tmp
# Integration tests use these (database khata_test; it is wiped at the start of each test run).
KHATA_TEST_DATABASE_URL_APP=postgresql+psycopg://khata_app:CHANGE_ME_app_password@/khata_test?host=/tmp
KHATA_TEST_DATABASE_URL_OWNER=postgresql+psycopg://khata_owner:CHANGE_ME_owner_password@/khata_test?host=/tmp

# Secrets (>= 32 random bytes each). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
KHATA_JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_bytes_long_xxxxxxxx
KHATA_OTP_PEPPER=CHANGE_ME_otp_pepper_at_least_32_bytes_long_xxxxxxxx
# Local KMS master key: base64 of exactly 32 bytes. Generate with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
KHATA_KMS_MASTER_KEY=Q0hBTkdFX01FX2xvY2FsX2ttc19rZXlfMzJfYnl0ZXM=

# SMS: console (dev only: OTP codes written to KHATA_DEV_OTP_FILE) | memory (tests only)
KHATA_SMS_GATEWAY=console
KHATA_DEV_OTP_FILE=var/dev-otp.log

KHATA_CORS_ORIGINS=["http://localhost:5173"]

# Dev seed (python -m khata.scripts.seed_dev) sets this password for every seeded user.
KHATA_SEED_DEV_PASSWORD=Khata-dev-2027!
